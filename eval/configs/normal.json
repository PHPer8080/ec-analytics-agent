{
  "criteria": {
    "numeric_accuracy": 1.0,
    "final_response_match_v2": {
      "threshold": 0.7,
      "judgeModelOptions": {
        "judgeModel": "gemini-2.5-flash",
        "numSamples": 3
      }
    },
    "hallucinations_v1": {
      "threshold": 0.8,
      "judgeModelOptions": {
        "judgeModel": "gemini-2.5-pro"
      }
    },
    "skill_usage": 1.0,
    "tool_call_integrity": 1.0,
    "agent_completion": 1.0
  },
  "customMetrics": {
    "numeric_accuracy": {
      "codeConfig": {
        "name": "eval.metrics.numeric_accuracy"
      },
      "description": "期待応答の数値がすべて実応答に現れるか（期待応答には問いが求めた値だけを書く）"
    },
    "skill_usage": {
      "codeConfig": {
        "name": "eval.metrics.skill_usage"
      },
      "description": "response-format のロードと分析スキルのロード順が規定どおりか"
    },
    "tool_call_integrity": {
      "codeConfig": {
        "name": "eval.metrics.tool_call_integrity"
      },
      "description": "ツール呼び出しをテキストとして出力していないか"
    },
    "agent_completion": {
      "codeConfig": {
        "name": "eval.metrics.agent_completion"
      },
      "description": "ターンを完遂しているか（空応答と定型文フォールバックを失敗とする）"
    }
  }
}
